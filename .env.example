# Supabase project (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key, server only. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string, used only by `npm run db:migrate`.
SUPABASE_DB_URL=

# Admin lifetime (boleh beberapa email, pisahkan dengan koma).
# Email di sini otomatis menjadi admin saat mendaftar/masuk.
ADMIN_EMAIL=
# Nomor WhatsApp admin, format internasional tanpa +. Contoh: 6281234567890
WHATSAPP_NUMBER=
# Harga lifetime dalam rupiah.
LIFETIME_PRICE=49000

# URL publik app, dipakai untuk tautan konfirmasi email Supabase.
APP_URL=http://localhost:3000

# Password gate opsional (HTTP Basic Auth). Kosongkan untuk app publik.
THREADCARD_PASSWORD=
THREADCARD_USER=threadcard
