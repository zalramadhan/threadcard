# Copy to .env.production.local, fill in, then push with:
#   node scripts/vercel-env.mjs --file .env.production.local --app-url https://your-domain
# .env.production.local is git-ignored. SUPABASE_DB_URL is not needed on Vercel.

NEXT_PUBLIC_SUPABASE_URL=https://hnlswbwqnbgyxpfkfiaa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public production URL, no trailing slash.
APP_URL=https://your-domain

# Comma-separated emails that become admins.
ADMIN_EMAIL=
# International format without +, e.g. 6281234567890.
WHATSAPP_NUMBER=
LIFETIME_PRICE=49000

# Optional HTTP Basic gate. Leave both empty for a public app.
THREADCARD_PASSWORD=
THREADCARD_USER=threadcard
